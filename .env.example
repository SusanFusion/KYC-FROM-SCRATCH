# ── App branding ────────────────────────────────────────────────────────────
# Human-readable product name shown throughout the UI. Change this one value
# to rebrand the app — nothing else needs to change.
NEXT_PUBLIC_APP_NAME="KYC From Scratch"

# ── Data persistence (REQUIRED on Vercel for imports to stick) ─────────────
# The app runs out of the box with NO env vars, using an in-memory data layer
# seeded from the provided performance report (see src/lib/data/seed). On
# Vercel that in-memory store is NOT shared between serverless function
# instances — different routes (e.g. the import API vs. the dashboard page)
# routinely run as separate instances even moments apart — so an import can
# appear to succeed and then simply not be there on the next page load or in
# Import History. This is expected behavior of the zero-config fallback, not
# a bug: it exists so the app deploys and demos with nothing configured, but
# it was never meant to hold real data.
#
# To get real, durable persistence (REQUIRED for Data Import — PDF or manual
# — to actually stick), create a Supabase project (supabase.com, free tier is
# enough), run supabase/schema.sql against it in the SQL editor, and set
# these two variables in Vercel → Settings → Environment Variables. When both
# are present the app automatically switches to the Supabase-backed
# repository — see src/lib/data/repository.ts. No code changes needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, used exclusively in server-side API routes (never sent to
# the browser) for writes that should bypass row-level security, e.g. the
# import-commit endpoint. Leave unset in local/demo mode.
SUPABASE_SERVICE_ROLE_KEY=

# ── Login (shared team passwords) ───────────────────────────────────────────
# Two roles, one shared password each: KYC Officers (agents) and Leads/
# Managers. Username is always the person's email address — the roster
# mapping each email to a role/agent lives in src/lib/auth/roster.ts (edit
# that file to add/remove people). Falls back to the placeholder passwords
# below if unset, so login still works zero-config in local/demo mode — SET
# REAL VALUES IN VERCEL for anything beyond a demo.
AGENT_SHARED_PASSWORD=
LEAD_SHARED_PASSWORD=

# Secret used to sign the login session cookie. Falls back to a fixed
# placeholder if unset (fine for local/demo use) — SET A REAL RANDOM VALUE IN
# VERCEL, since anyone who knows this secret could forge a session. Generate
# one with, e.g., `openssl rand -hex 32`.
AUTH_SECRET=
