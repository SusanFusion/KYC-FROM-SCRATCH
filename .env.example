# ── App branding ────────────────────────────────────────────────────────────
# Human-readable product name shown throughout the UI. Change this one value
# to rebrand the app — nothing else needs to change.
NEXT_PUBLIC_APP_NAME="KYC From Scratch"

# ── Data persistence (optional) ────────────────────────────────────────────
# The app runs out of the box with NO env vars, using a local JSON-backed data
# layer seeded from the provided performance report (see src/lib/data/seed).
# That local store resets on every serverless cold start on Vercel, so it is
# fine for demos but NOT durable production storage.
#
# To get real, durable persistence (required for the PDF Data Import workflow
# to actually stick across deployments/restarts), create a Supabase project,
# run supabase/schema.sql against it, and set these two variables. When both
# are present the app automatically switches to the Supabase-backed
# repository — see src/lib/data/repository.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, used exclusively in server-side API routes (never sent to
# the browser) for writes that should bypass row-level security, e.g. the
# import-commit endpoint. Leave unset in local/demo mode.
SUPABASE_SERVICE_ROLE_KEY=
